# =================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN UTE BADMINTON MANAGEMENT
# =================================================================
# LƯU Ý BẢO MẬT:
# 1. KHÔNG BAO GIỜ commit file chứa thông tin thật (.env) lên GitHub!
# 2. File này (.env.example) là file mẫu hướng dẫn các biến môi trường.
# 3. Khi triển khai lên Cloud (Render.com hoặc Railway.app):
#    - Không cần đẩy file .env.
#    - Vào mục "Variables" / "Environment Variables" trên Dashboard của Cloud
#      và thêm các cặp KEY - VALUE bên dưới.
# =================================================================

# --- 1. CỔNG MẠNG (Render / Railway tự động cấp, mặc định 8080) ---
PORT=8080

# --- 2. CƠ SỞ DỮ LIỆU SQL SERVER TRÊN CLOUD ---
# URL kết nối tới SQL Server (Docker Container hoặc Cloud Managed DB)
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=badminton;encrypt=true;trustServerCertificate=true;
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=YourPassword123

# --- 3. TÀI KHOẢN NGÂN HÀNG NHẬN TIỀN CỌC (VIETQR) ---
# Mã BIN ngân hàng (Ví dụ: MBBank: 970422 | Vietcombank: 970436 | Techcombank: 970407 | ACB: 970416 | BIDV: 970418)
VIETQR_BANK_BIN=970422
VIETQR_BANK_NAME=MBBank (Ngân hàng Quân Đội)
VIETQR_ACCOUNT_NO=0903123456
VIETQR_ACCOUNT_NAME=NGUYEN VAN A
VIETQR_WEBHOOK_TOKEN=UTE_VIETQR_SECRET_TOKEN_2026

# --- 4. GOOGLE GEMINI AI (TÙY CHỌN) ---
# Nếu để trống, chatbot tự động dùng mô hình NLP TF-IDF Java thuần có sẵn mà không cần API Key
GEMINI_API_KEY=

# --- 5. GMAIL GỬI EMAIL XÁC NHẬN ĐẶT SÂN (SMTP) ---
# Mật khẩu ứng dụng 16 ký tự lấy từ Google Account -> Bảo mật -> Mật khẩu ứng dụng
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=utesport.badminton@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_app_password

# --- 6. CLOUDINARY LƯU ẢNH HÓA ĐƠN & MINH CHỨNG ---
CLOUDINARY_CLOUD_NAME=utesport-arena
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 7. JWT BẢO MẬT ĐĂNG NHẬP & PHIÊN LÀM VIỆC ---
JWT_SECRET=UTE_BADMINTON_MANAGEMENT_SUPER_SECRET_KEY_2026_JWT_TOKEN_CHAIN_PRO
